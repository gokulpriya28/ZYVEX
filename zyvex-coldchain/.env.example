# Supabase -> Project Settings -> API. Keep SERVICE_ROLE_KEY server-side only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Use a long random secret in production. Never expose this as NEXT_PUBLIC_...
HMAC_SECRET=replace-with-at-least-32-random-characters

# Optional EVM testnet integration. Deploy contracts/ColdChainLedger.sol first.
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=11155111
